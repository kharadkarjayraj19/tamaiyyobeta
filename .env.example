# Public (safe for the browser bundle)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth (server) — required for real deployments; see docs/features/frontend-auth-architecture.md
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Set to "false" to disable optimistic middleware redirects (local exploration only).
AUTH_MIDDLEWARE_ENABLED=true

# Local dev only: bypass role-dashboard auth checks with deterministic mock sessions.
# Never enable outside local development.
DEV_AUTH_BYPASS=false

# Database (server) — PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/tamayo_dev
DATABASE_URL=
# Optional shadow DB for Prisma migrate workflows
# Example: postgresql://user:password@localhost:5432/tamayo_shadow
SHADOW_DATABASE_URL=

# Google Maps APIs (server)
# Backward-compatible single key (works for both directions + places if allowed):
GOOGLE_MAPS_API_KEY=
# Preferred split keys (production-ready):
GOOGLE_MAPS_DIRECTIONS_API_KEY=
GOOGLE_MAPS_PLACES_API_KEY=

# PostHog (client + server analytics)
# NEXT_PUBLIC_POSTHOG_KEY is the project API key (safe for browser).
# POSTHOG_PROJECT_API_KEY can reuse the same key or be set explicitly for server capture.
# Host defaults to US cloud; override for EU/self-host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# MSG91 OTP (server)
# Required for production OTP SMS delivery.
# If unset, local/dev flow falls back to in-memory debug OTP.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
